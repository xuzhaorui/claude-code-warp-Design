# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — never commit signing keys or credentials (migration doc 02 §8)
*.jks
*.keystore
key.properties
warehouse-release.jks

# Web build output (regenerable via npm run build; bundled into flutter_shell/assets)
wms-app/
certs/

# Local install / dev logs
.flutter-install.log
.vite-dev.out.log
.vite-dev.err.log

# Deprecated Capacitor project (superseded by Flutter shell — still on disk, not tracked).
# Leading slash anchors to repo root so flutter_shell/android/ is NOT matched.
/android/
/mobile/

# Flutter shell build artifacts (project's own .gitignore also applies)
flutter_shell/build/
flutter_shell/.dart_tool/
flutter_shell/android/.gradle/
flutter_shell/android/captures/
flutter_shell/android/local.properties


# Physical gate runtime report (regenerable via npm run physical:gate)
physical-gate.report.json
